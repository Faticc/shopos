# По умолчанию нормализуем в LF внутри репозитория
* text=auto eol=lf

# Исходники машины хранятся байт-в-байт: установщик качает их как есть и
# кладёт на диск компьютера, никакой нормализации по дороге быть не должно.
*.lua  -text
*.cfg  -text

# Каталог иконок — двоичный, его трогать нельзя ни при каких настройках
*.bin  binary
